# Google Sheets (veja o passo a passo no plano de implementação)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
SHEET_TAB_NAME=Jogos

# APIs de enriquecimento
RAWG_API_KEY=
TGDB_API_KEY=
STEAMGRIDDB_API_KEY=

# Login (senha única)
# Gere com: node -e "console.log(require('bcryptjs').hashSync('sua-senha', 10))"
# IMPORTANTE: o hash do bcrypt é cheio de "$" (ex: $2b$10$...), e o carregador de .env do
# Next.js expande "$VAR" como variável. Escape cada "$" como "\$" para colar o hash aqui,
# senão ele é corrompido silenciosamente e o login nunca bate.
APP_PASSWORD_HASH=
# Gere com: openssl rand -base64 32
SESSION_SECRET=
